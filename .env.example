# ==========================
# API
# ==========================

APP_NAME=desafio-go
APP_ENV=development
APP_PORT=8080

# ==========================
# PostgreSQL
# ==========================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# String de conexão utilizada pela aplicação
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# ==========================
# JWT (Opcional)
# ==========================

JWT_SECRET=change-me
JWT_EXPIRES_IN=24h