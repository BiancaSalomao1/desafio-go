# ==========================
# API
# ==========================

APP_NAME=desafio-go
APP_ENV=development
APP_PORT=8080

# ==========================
# PostgreSQL
# ==========================

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app


# Para execução LOCAL (go run)
DATABASE_URL=postgres://app:app@localhost:5433/app?sslmode=disable

# Para execução via Docker Compose,
# o docker-compose sobrescreve DATABASE_URL para:
# postgres://app:app@postgres:5432/app?sslmode=disable

# ==========================
# JWT
# ==========================

JWT_SECRET=change-me
JWT_EXPIRES_IN=24h